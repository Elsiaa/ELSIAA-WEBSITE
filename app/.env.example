# ELSIAA — copy to `.env.local`. Do not commit secrets.
#
# ── Minimum to use /admin right now ──────────────────────────
# SUPER_ADMIN_EMAILS=you@elsiaa.com
# ADMIN_KEY=pick-a-long-secret
# AUTH_SECRET=another-32-plus-char-secret
#
# That’s enough for admin sign-in + empty portal/billing UI.
# Everything else can wait until you need that feature.

# --- Site ---
# VITE_SITE_URL=https://elsiaa.com

# --- Database (optional direct Postgres; prefer Supabase for app data) ---
# DATABASE_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_SSL_NO_VERIFY=1

# --- Auth / super admin ---
# AUTH_SECRET=  (seals admin session cookie that stores Supabase tokens)
# AUTH_URL=http://localhost:5173
# SUPER_ADMIN_EMAILS=you@elsiaa.com
# Optional legacy gate (no longer used for /admin login):
# ADMIN_KEY=

# --- Supabase (RLS data plane + Auth for /admin) ---
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=  (anon / publishable)
# SUPABASE_SECRET_KEY=       (service role — scoped mail API + bootstrap only)
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Legacy aliases still work:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (when you’re ready to take payments) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
# Optional branding on invoices:
# PAYMENT_COMPANY_NAME=ELSIAA
# PAYMENT_CONTACT_EMAIL=info@elsiaa.com
# CRON_SECRET=

# --- Elssia Mail API (admin Mail control plane + ALL app transactional mail) ---
# Required for invites, billing, support, signatures, payments emails:
# ELSSIA_MAIL_API_KEY=
# ELSSIA_MAIL_API_BASE=https://mail.elsiaa.com/mail-api
# From must be @elsiaa.com:
# SMTP_FROM_EMAIL=hello@elsiaa.com
# SMTP_FROM_NAME=ELSIAA
# Optional emergency SMTP only if Mail API is down:
# TRANSACTIONAL_MAIL_SMTP_FALLBACK=1
# ZOHO_EMAIL=
# ZOHO_APP_PASSWORD=
# EMAIL_USER=
# EMAIL_PASS=
# Full schema: paste app/migrations/elsiaa_supabase_full.sql (see migrations/README.md).
# Also run migrations/0008_mail_send_log_transactional.sql
# SUPABASE_SECRET_KEY is required for /api/mail/v1/* (service role after emk_ auth).

# --- Object storage (files later) ---
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
